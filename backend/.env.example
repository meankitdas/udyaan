# Server
PORT=8080
CORS_ORIGINS=http://localhost:3000

# Admin auth
ADMIN_EMAIL=admin@udyaan.edu
ADMIN_PASSWORD=udyaan-admin
JWT_SECRET=change-me-in-production

# AWS (leave DATABASE_URL empty to use local JSON storage)
DATABASE_URL=
AWS_REGION=ap-south-1
# Community attachments (portal). This bucket is public-read: the portal hands
# attachments out as plain public URLs. Leave empty to disable those uploads.
S3_BUCKET=
# Candidate CVs. Must be a SEPARATE, PRIVATE bucket -- a CV is personal data and
# is only served through short-lived signed URLs, so it must not live in the
# public-read assets bucket. There is no fallback to S3_BUCKET on purpose:
# leaving this empty disables CV uploads rather than publishing every CV.
# Setting it to the same value as S3_BUCKET is refused at startup.
SURVEY_CV_BUCKET=
# Where candidate CVs are stored inside the bucket, and the per-file size cap
SURVEY_CV_PREFIX=survey-cv
MAX_CV_BYTES=10485760

# Azure OpenAI (leave empty to use heuristic screening)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-06-01
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
