# Server
PORT=8080
CORS_ORIGINS=http://localhost:3000

# Admin auth
ADMIN_EMAIL=admin@udyaan.edu
ADMIN_PASSWORD=udyaan-admin
JWT_SECRET=change-me-in-production

# AWS (leave DATABASE_URL empty to use local JSON storage)
DATABASE_URL=
AWS_REGION=ap-south-1
# Leave S3_BUCKET empty to disable community attachment uploads
S3_BUCKET=

# Azure OpenAI (leave empty to use heuristic screening)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-06-01
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
